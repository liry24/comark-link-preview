{
  "name": "comark-link-preview",
  "version": "0.0.0",
  "private": true,
  "description": "Explicit link previews for Comark",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liry24/comark-link-preview.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "node node_modules/tsdown/dist/run.mjs",
    "format": "node node_modules/oxfmt/bin/oxfmt . --write",
    "format:check": "node node_modules/oxfmt/bin/oxfmt . --check",
    "lint": "node node_modules/oxlint/bin/oxlint --type-aware .",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "deps:update": "node node_modules/taze/bin/taze.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "node node_modules/vite/bin/vite.js --config playground/web/vite.config.ts",
    "build:playground:web": "node node_modules/vite/bin/vite.js build --config playground/web/vite.config.ts",
    "dev:angular": "cd playground && node ../node_modules/@angular/cli/bin/ng.js serve",
    "dev:nuxt": "node node_modules/nuxt/bin/nuxt.mjs dev playground/nuxt --host 127.0.0.1 --port 3000",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "dev:cli": "node playground/cli/main.ts",
    "build:playground:angular": "cd playground && node ../node_modules/@angular/cli/bin/ng.js build",
    "build:playground:nuxt": "node node_modules/nuxt/bin/nuxt.mjs build playground/nuxt",
    "pack:check": "node scripts/pack.mjs",
    "test:consumer": "node scripts/consumer.mjs",
    "test:package": "node scripts/package-check.mjs",
    "test:workers": "node scripts/workers.mjs",
    "bundle:size": "bun run build && bun scripts/measure-bundles.mjs --package-root ."
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-server": "21.2.25",
    "@arethetypeswrong/cli": "^0.18.5",
    "@comark/angular": "^0.7.0",
    "@comark/ansi": "^0.7.0",
    "@comark/html": "^0.7.0",
    "@comark/react": "^0.7.0",
    "@comark/svelte": "^0.7.0",
    "@comark/vue": "^0.7.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.1",
    "miniflare": "4.20260730.0",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "parse5": "^8.0.1",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svelte": "^5.57.1",
    "taze": "^21.3.0",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "peerDependencies": {
    "comark": "^0.7.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.2"
}
